rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function codeDoc(code) {
      return get(/databases/$(database)/documents/codes/$(code)).data;
    }
    function hasCode(code) {
      return isSignedIn()
        && code is string
        && exists(/databases/$(database)/documents/codes/$(code));
    }
    function canCreateNotice(data) {
      return hasCode(data.authorCode)
        && (
          (
            data.channel == 'teachers_room'
            && codeDoc(data.authorCode).role == 'teacher'
          )
          || (
            data.channel != 'teachers_room'
            && (
              codeDoc(data.authorCode).role in ['rapporteur', 'dept_admin', 'teacher']
              || (
                codeDoc(data.authorCode).role == 'rep'
                && codeDoc(data.authorCode).stage == data.stage
              )
            )
          )
        );
    }
    function canModifyNotice(existing) {
      return hasCode(existing.authorCode)
        && (
          codeDoc(existing.authorCode).role in ['rapporteur', 'dept_admin']
          || (
            codeDoc(existing.authorCode).role in ['teacher', 'rep']
            && existing.authorCode == codeDoc(existing.authorCode).code
          )
        );
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || canCreateNotice(request.resource.data);
      allow update, delete: if isAdmin() || canModifyNotice(resource.data);
    }

    match /codes/{codeId} {
      allow get, list: if isSignedIn();
      allow delete: if isAdmin();
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.role == 'student'
        && request.resource.data.used == false
      );
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'name', 'phone', 'dept', 'stage', 'section', 'usedAt'])
      );
    }
  }
}
