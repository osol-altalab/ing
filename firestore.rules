rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function codeDoc(code) {
      return get(/databases/$(database)/documents/codes/$(code)).data;
    }
    function hasCode(code) {
      return isSignedIn()
        && code is string
        && exists(/databases/$(database)/documents/codes/$(code));
    }
    function canAcademicWrite(data) {
      return hasCode(data.authorCode)
        && codeDoc(data.authorCode).role in ['rep', 'rapporteur', 'teacher', 'dept_admin'];
    }
    function canCreateNotice(data) {
      return hasCode(data.authorCode)
        && (
          (
            data.channel == 'teachers_room'
            && codeDoc(data.authorCode).role == 'teacher'
          )
          || (
            data.channel == 'private_student'
            && codeDoc(data.authorCode).role in ['rapporteur', 'dept_admin']
            && data.targetStudentCode is string
            && exists(/databases/$(database)/documents/codes/$(data.targetStudentCode))
          )
          || (
            data.channel != 'teachers_room'
            && data.channel != 'private_student'
            && (
              codeDoc(data.authorCode).role in ['rapporteur', 'dept_admin', 'teacher']
              || (
                codeDoc(data.authorCode).role == 'rep'
                && codeDoc(data.authorCode).stage == data.stage
              )
            )
          )
        );
    }
    function canModifyNotice(existing) {
      return hasCode(existing.authorCode)
        && (
          codeDoc(existing.authorCode).role in ['rapporteur', 'dept_admin']
          || (
            codeDoc(existing.authorCode).role in ['teacher', 'rep']
            && existing.authorCode == codeDoc(existing.authorCode).code
          )
        );
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deptLogos', 'actorCode', 'actorDept', 'updatedAt'])
          && hasCode(request.resource.data.actorCode)
          && codeDoc(request.resource.data.actorCode).role in ['rapporteur', 'dept_admin']
          && codeDoc(request.resource.data.actorCode).dept == request.resource.data.actorDept
        );
    }

    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || canCreateNotice(request.resource.data);
      allow delete: if isAdmin() || canModifyNotice(resource.data);
      allow update: if isAdmin()
        || canModifyNotice(resource.data)
        || (
          isSignedIn()
          && resource.data.channel == 'private_student'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies'])
          && request.resource.data.replies.size() <= (resource.data.get('replies', []).size() + 1)
        );
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || canAcademicWrite(request.resource.data);
      allow update: if isAdmin() || canAcademicWrite(resource.data);
      allow delete: if isAdmin() || canAcademicWrite(resource.data);
    }

    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || canAcademicWrite(request.resource.data);
      allow delete: if isAdmin() || canAcademicWrite(resource.data);
    }

    match /homeworks/{homeworkId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || canAcademicWrite(request.resource.data);
      allow delete: if isAdmin() || canAcademicWrite(resource.data);
    }

    match /exam_rooms/{roomId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin()
        || (
          hasCode(request.resource.data.authorCode)
          && codeDoc(request.resource.data.authorCode).role in ['rapporteur', 'dept_admin']
        )
        || (
          hasCode(resource.data.authorCode)
          && codeDoc(resource.data.authorCode).role in ['rapporteur', 'dept_admin']
        );
    }

    match /codes/{codeId} {
      allow get, list: if isSignedIn();
      allow delete: if isAdmin();
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.role == 'student'
        && request.resource.data.used == false
      );
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.used == false
          && request.resource.data.used == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'name', 'phone', 'dept', 'stage', 'section', 'online', 'lastSeen', 'usedAt'])
        )
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['online', 'lastSeen'])
        )
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'name', 'phone', 'stage', 'section', 'graduated', 'seatNumber', 'examRoom', 'actorCode'])
          && hasCode(request.resource.data.actorCode)
          && codeDoc(request.resource.data.actorCode).role in ['rapporteur', 'dept_admin']
          && codeDoc(request.resource.data.actorCode).dept == resource.data.dept
        );
    }
  }
}
