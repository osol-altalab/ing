rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isDeptMgr(code, targetStage) {
      return isSignedIn()
        && code is string
        && exists(/databases/$(database)/documents/codes/$(code))
        && (
          get(/databases/$(database)/documents/codes/$(code)).data.role in ['rapporteur', 'teacher', 'dept_admin']
          || get(/databases/$(database)/documents/codes/$(code)).data.stage == 'all'
          || (
            get(/databases/$(database)/documents/codes/$(code)).data.role == 'rep'
            && get(/databases/$(database)/documents/codes/$(code)).data.stage == targetStage
          )
        );
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isDeptMgr(request.resource.data.authorCode, request.resource.data.stage);
      allow update, delete: if isAdmin() || isDeptMgr(resource.data.authorCode, resource.data.stage);
    }

    match /codes/{codeId} {
      allow get, list: if isSignedIn();
      allow delete: if isAdmin();
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.role == 'student'
        && request.resource.data.used == false
      );
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'name', 'phone', 'dept', 'stage', 'section', 'usedAt'])
      );
    }
  }
}
